# ============================================================
# Shoes Store Management System — Environment Configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://shoes_admin:changeme@localhost:5432/shoes_store_db?schema=public

# --- Auth secrets ---
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- CORS ---
# Comma-separated list of allowed origins for the Electron desktop client(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,app://.

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Super Admin bootstrap (used only by prisma/seed.ts on first run) ---
SUPER_ADMIN_EMAIL=superadmin@shoes-system.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- Logging ---
LOG_LEVEL=info

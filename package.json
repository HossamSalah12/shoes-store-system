{
  "name": "shoes-store-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant SaaS Desktop system for shoe store management (POS, Inventory, Multi-Branch, Reports)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run build --workspace=packages/shared && npm run build --workspace=packages/validation && npm run dev --workspace=apps/server",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace=apps/server",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=apps/server",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/server",
    "prisma:seed": "npm run prisma:seed --workspace=apps/server"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED"
}

{
  "appId": "com.shoesstore.desktop",
  "productName": "Shoes Store Management System",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis"
  },
  "mac": {
    "target": "dmg",
    "hardenedRuntime": true
  },
  "linux": {
    "target": "AppImage"
  },
  "asar": true
}

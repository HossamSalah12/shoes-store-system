// ============================================================================
// Shoes Store Management System — Prisma Schema (PostgreSQL)
// Multi-Tenant SaaS. Every tenant-scoped model carries an explicit tenantId
// column (never inferred solely from a relation) so that every query issued
// by the backend can — and must — filter directly on tenantId. This is the
// primary defense against IDOR / cross-tenant data leakage; see
// apps/server/src/middleware/tenantIsolation.ts and
// apps/server/src/lib/scopedPrisma.ts for how this is enforced in code.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Platform level (Super Admin) — Tenants, Plans, Subscriptions
// ----------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  DISABLED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  branches      Branch[]
  users         User[]
  roles         Role[]
  products      Product[]
  brands        Brand[]
  categories    Category[]
  colors        Color[]
  sizes         Size[]
  suppliers     Supplier[]
  customers     Customer[]
  sales         Sale[]
  purchases     Purchase[]
  expenses      Expense[]
  stockMovements StockMovement[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  settings      Settings?

  @@index([status])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  maxBranches Int
  maxUsers    Int
  durationDays Int
  priceCents  Int      @default(0)
  features    String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(TRIAL)
  startDate DateTime           @default(now())
  endDate   DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
}

// ----------------------------------------------------------------------------
// Tenant structure — Branches, Users, Roles, Permissions
// ----------------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBranches   UserBranch[]
  sales          Sale[]
  purchases      Purchase[]
  expenses       Expense[]
  stockMovements StockMovement[]
  stockLevels    StockLevel[]
  transfersOut   StockTransfer[] @relation("TransferFromBranch")
  transfersIn    StockTransfer[] @relation("TransferToBranch")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String? // null only for SUPER_ADMIN (platform-level user)
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRoles    UserRole[]
  userBranches UserBranch[]
  sessions     Session[]
  sales        Sale[]           @relation("SaleCashier")
  stockMovements StockMovement[] @relation("StockMovementUser")
  auditLogs    AuditLog[]
  cancelledSales Sale[]         @relation("SaleCancelledBy")

  // Email is unique per-tenant (two different tenants may have an owner with
  // the same email address). Platform-level users (tenantId null) must be
  // globally unique, enforced additionally in the auth service.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

// Explicit join table: a Branch Manager or Cashier may be restricted to a
// subset of branches. An OWNER implicitly has access to ALL branches of
// their tenant (checked in code, not via this table) since Owners manage the
// whole tenant.
model UserBranch {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String? // null for platform-level roles (SUPER_ADMIN)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String // e.g. OWNER, BRANCH_MANAGER, CASHIER, or a custom code
  name      String
  isSystem  Boolean  @default(true) // system roles cannot be deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "product.create" — matches packages/shared PERMISSIONS
  description String

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash    String
  userAgent           String?
  ipAddress           String?
  revokedAt           DateTime?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ----------------------------------------------------------------------------
// Catalogue — Products, Variants, Brands, Categories, Colors, Sizes
// ----------------------------------------------------------------------------

model Brand {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Category {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Color {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  hexCode  String?
  variants ProductVariant[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Size {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label    String // e.g. "42", "EU 42", "US 9"
  sortOrder Int             @default(0)
  variants ProductVariant[]

  @@unique([tenantId, label])
  @@index([tenantId])
}

model Product {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  brandId      String?
  brand        Brand?   @relation(fields: [brandId], references: [id])
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  description  String?
  imageUrl     String?
  sku          String
  barcode      String?
  costPrice    Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants ProductVariant[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([barcode])
}

model ProductVariant {
  id           String   @id @default(cuid())
  tenantId     String // duplicated from Product for direct, fast, safe filtering
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId       String
  size         Size     @relation(fields: [sizeId], references: [id])
  colorId      String
  color        Color    @relation(fields: [colorId], references: [id])
  sku          String
  barcode      String?
  costPrice    Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  returnItems    ReturnItem[]
  transfers      StockTransfer[]

  @@unique([tenantId, sku])
  @@unique([productId, sizeId, colorId])
  @@index([tenantId])
  @@index([barcode])
}

// Materialized, per-branch stock level. This is a denormalized cache that is
// always updated atomically together with a StockMovement row inside the
// same DB transaction (see inventory.service.ts). StockMovement remains the
// append-only source of truth / audit trail; StockLevel exists purely so
// "current stock" reads don't require summing movements every time.
model StockLevel {
  id        String         @id @default(cuid())
  tenantId  String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([variantId, branchId])
  @@index([tenantId])
  @@index([branchId])
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

// Append-only ledger — the single source of truth for all inventory changes.
model StockMovement {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type       StockMovementType
  quantity   Int // always positive; direction implied by `type`
  reason     String?
  userId     String?
  user       User?             @relation("StockMovementUser", fields: [userId], references: [id])
  referenceId String? // e.g. saleId / purchaseId / returnId / transferId
  createdAt  DateTime          @default(now())

  @@index([tenantId])
  @@index([branchId])
  @@index([variantId])
  @@index([tenantId, branchId, variantId])
  @@index([referenceId])
}

model StockTransfer {
  id           String   @id @default(cuid())
  tenantId     String
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  fromBranchId String
  fromBranch   Branch   @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranchId   String
  toBranch     Branch   @relation("TransferToBranch", fields: [toBranchId], references: [id])
  quantity     Int
  notes        String?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
}

// ----------------------------------------------------------------------------
// Suppliers / Purchases
// ----------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  // Amount currently owed to this supplier (accounts payable). Increases
  // when a Purchase is recorded (we now owe them for the goods received),
  // decreases when a SupplierPayment is recorded (we paid them). This
  // column is a denormalized cache updated atomically alongside each
  // Purchase/SupplierPayment write — SupplierPayment is the append-only
  // source of truth, exactly mirroring how StockLevel/StockMovement work
  // for inventory (see inventory/stockMovement.ts).
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  payments  SupplierPayment[]

  @@index([tenantId])
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model Purchase {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch         @relation(fields: [branchId], references: [id])
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  status     PurchaseStatus @default(RECEIVED)
  totalCost  Decimal        @db.Decimal(12, 2)
  notes      String?
  userId     String?
  createdAt  DateTime       @default(now())

  items PurchaseItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  unitCost   Decimal        @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([variantId])
}

// Append-only ledger of payments made to a supplier — the source of truth
// for Supplier.balance, exactly mirroring how StockMovement is the source
// of truth for StockLevel.
model SupplierPayment {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  method     String? // free-text: e.g. "Cash", "Bank Transfer"
  reference  String?
  notes      String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([supplierId])
}

// ----------------------------------------------------------------------------
// Customers
// ----------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@index([tenantId])
  @@index([phone])
}

// ----------------------------------------------------------------------------
// Sales / POS / Returns
// ----------------------------------------------------------------------------

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
}

model Sale {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch     @relation(fields: [branchId], references: [id])
  cashierId       String
  cashier         User       @relation("SaleCashier", fields: [cashierId], references: [id])
  customerId      String?
  customer        Customer?  @relation(fields: [customerId], references: [id])
  invoiceNumber   String
  status          SaleStatus @default(COMPLETED)
  subtotal        Decimal    @db.Decimal(12, 2)
  discountAmount  Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal    @db.Decimal(12, 2)
  // Idempotency: the POS client generates this UUID once per checkout attempt.
  // Unique per tenant so that retried/duplicate submissions (e.g. after a
  // dropped connection) never create two sales.
  clientRequestId String
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?      @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  cancelReason    String?
  createdAt       DateTime   @default(now())

  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId, createdAt])
  @@index([cashierId])
}

model SaleItem {
  id             String         @id @default(cuid())
  saleId         String
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPrice      Decimal        @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal        @db.Decimal(12, 2)

  returnItems ReturnItem[]

  @@index([saleId])
  @@index([variantId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  @@index([saleId])
}

model Return {
  id        String   @id @default(cuid())
  tenantId  String
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  branchId  String
  reason    String
  totalAmount Decimal @db.Decimal(12, 2)
  userId    String?
  createdAt DateTime @default(now())

  items ReturnItem[]

  @@index([tenantId])
  @@index([saleId])
  @@index([branchId])
}

model ReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  returnRow  Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])
  quantity   Int
  amount     Decimal  @db.Decimal(12, 2)

  @@index([returnId])
  @@index([saleItemId])
}

// ----------------------------------------------------------------------------
// Expenses
// ----------------------------------------------------------------------------

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, date])
}

// ----------------------------------------------------------------------------
// Settings / Audit
// ----------------------------------------------------------------------------

model Settings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency  String   @default("EGP")
  locale    String   @default("ar")
  invoicePrefix String @default("INV")
  lowStockThreshold Int @default(5)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String? // null for platform-level actions performed by SUPER_ADMIN
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "sale.create", "user.delete", "auth.login"
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([tenantId, createdAt])
}
